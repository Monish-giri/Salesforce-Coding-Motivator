{
  "name": "salesforce-coding-motivator",
  "displayName": "Salesforce Coding Motivator",
  "description": "A lightweight motivational companion for Salesforce developers working in VS Code.",
  "version": "0.1.0",
  "publisher": "monishgiri-2001",
  "repository": {
    "type": "git",
    "url": "https://github.com/Monish-giri/Salesforce-Coding-Motivator"
  },
  "homepage": "https://github.com/Monish-giri/Salesforce-Coding-Motivator",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "salesforce",
    "apex",
    "lwc",
    "motivation",
    "developer productivity"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "salesforce-coding-motivator.start",
        "title": "Salesforce Coding Motivator: Start"
      },
      {
        "command": "salesforce-coding-motivator.stop",
        "title": "Salesforce Coding Motivator: Stop"
      },
      {
        "command": "salesforce-coding-motivator.showHistory",
        "title": "Salesforce Coding Motivator: Show Old Chat"
      },
      {
        "command": "salesforce-coding-motivator.showSessionSummary",
        "title": "Salesforce Coding Motivator: Show Session Summary"
      },
      {
        "command": "salesforce-coding-motivator.clearHistory",
        "title": "Salesforce Coding Motivator: Clear Chat History"
      },
      {
        "command": "salesforce-coding-motivator.triggerDeploymentMessage",
        "title": "Salesforce Coding Motivator: Trigger Deployment Message"
      },
      {
        "command": "salesforce-coding-motivator.showDeploymentChecklist",
        "title": "Salesforce Coding Motivator: Show Deployment Checklist"
      },
      {
        "command": "salesforce-coding-motivator.deployAndMonitor",
        "title": "Salesforce Coding Motivator: Deploy Active Source and Monitor"
      },
      {
        "command": "salesforce-coding-motivator.openCompanionMenu",
        "title": "Salesforce Coding Motivator: Open Companion"
      },
      {
        "command": "salesforce-coding-motivator.openCompanionView",
        "title": "Salesforce Coding Motivator: Show Mascot Companion"
      }
    ],
    "configuration": {
      "title": "Salesforce Coding Motivator",
      "properties": {
        "salesforceCodingMotivator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the motivational notifications for the session."
        },
        "salesforceCodingMotivator.debugTestMode": {
          "type": "boolean",
          "default": false,
          "description": "Use shorter test-friendly message thresholds for local validation."
        },
        "salesforceCodingMotivator.messageCooldownMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 60,
          "description": "Cooldown period in minutes between repeat motivational messages."
        },
        "salesforceCodingMotivator.idleThresholdMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 60,
          "description": "Minutes of inactivity before the session is marked idle."
        },
        "salesforceCodingMotivator.breakReminderMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 180,
          "description": "Minutes of idle time before a break reminder is shown."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "salesforceCodingMotivatorSecondary",
          "title": "Motivator",
          "icon": "media/motivator.svg"
        }
      ]
    },
    "views": {
      "salesforceCodingMotivatorSecondary": [
        {
          "id": "salesforceCodingMotivator.companionView",
          "name": "Salesforce Coding Motivator",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test out/test/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.2"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
